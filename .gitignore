# Data: synthetic dev pack IS tracked (clone-and-run, no extra step for
# judges/teammates). If/when the real organizer data pack replaces it,
# add a real_data/ override rule here instead of re-excluding data/.
# data/*.csv
# data/*.json

# Models / artifacts. Large refits stay out, but the models the dashboard
# actually loads are tracked so a clone -- or a deployed instance -- works
# without running the full pipeline first. `models/*.joblib` only matches
# the top level, which is why models/supervised/ was already tracked by
# accident while models/transition_model.joblib was not: the what-if
# simulator returned probabilities but no next-state prediction.
models/*.joblib
models/*.pkl
!models/.gitkeep
!models/transition_model.joblib
!models/supervised/

# Logs
logs/*.jsonl
!logs/.gitkeep
# EXCEPT the LLM audit trail: Task 7 requires prompt logs and the judging
# criteria name them explicitly, so this is a deliverable, not a runtime
# artifact. It contains prompts, outputs and guardrail verdicts about
# synthetic loans -- no credentials, no real borrower data.
!logs/llm_calls.jsonl

# Env
.env

# Python
__pycache__/
*.pyc
.pytest_cache/
*.egg-info/

# Streamlit
.streamlit/secrets.toml

# OS
.DS_Store

# Editor / assistant tooling. Machine-local, and useless to
# anyone without the same tool installed.
.claude/
.vscode/

# Personal working documents, not deliverables.
docs/demo_video_script.pdf
scripts/build_demo_script.py
